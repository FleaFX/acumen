<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Shared version for the AcumenRx, AcumenRx.Xunit and AcumenRx.Xunit.v3 packages. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>rx;reactive;marble;testing</PackageTags>
  </PropertyGroup>

</Project>
